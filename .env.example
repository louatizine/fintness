# Variables publiques Expo: ne mettez jamais de mot de passe MongoDB ici.
EXPO_PUBLIC_ATLAS_APP_ID=<app-id>
EXPO_PUBLIC_ATLAS_DATA_API_URL=https://data.mongodb-api.com/app/<app-id>/endpoint/data/v1
EXPO_PUBLIC_ATLAS_DATA_API_KEY=<data-api-key>
EXPO_PUBLIC_ATLAS_DATA_SOURCE=mongodb-atlas
EXPO_PUBLIC_ATLAS_DB_NAME=fintness