# The base URL of your Iron Log backend (no trailing slash)
# Production (Render): https://fintness.onrender.com
# Local: http://localhost:3001 — on a physical device use your PC LAN IP, e.g. http://192.168.1.10:3001
EXPO_PUBLIC_API_URL=https://fintness.onrender.com

# Google OAuth client IDs (Google Cloud Console). These are public identifiers, not secrets.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Maps SDK key (Maps SDK for Android + Maps SDK for iOS). Baked into native
# config at build time — not needed in JS. Optional platform overrides below.
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY_ANDROID=
# GOOGLE_MAPS_API_KEY_IOS=

# Optional path to google-services.json for local native builds (npx expo run:android).
# For EAS cloud builds, upload FCM V1 with: eas credentials -p android
# GOOGLE_SERVICES_JSON=./google-services.json

# Push notifications (Android first):
# 1) Create a Firebase Android app with package com.zineeddine.ironlog
# 2) Upload FCM V1 service account JSON via: eas credentials -p android
# 3) Build: npm run build:android:preview   (or build:android:dev)
# Remote push does not work in Expo Go on Android — use an EAS APK.
# iOS APNs credentials can be added later with: eas credentials -p ios

