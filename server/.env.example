MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/fintness?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-random-64-char-string
PORT=3001

# Same value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID — used to verify Google ID tokens.
GOOGLE_WEB_CLIENT_ID=
# Optional but required to verify native iOS/Android ID tokens (audience is the platform client ID).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
